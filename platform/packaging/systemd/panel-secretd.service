[Unit]
Description=CyberPanel protected secret material broker
Documentation=https://github.com/aonsyed/cyberpanel
After=local-fs.target
Before=panel-execd.service panel-providerd.service panel-core.service

[Service]
Type=simple
User=cyberpanel-secrets
Group=cyberpanel-secrets
SupplementaryGroups=cyberpanel
ExecStart=/usr/local/libexec/cyberpanel/panel-secretd
LoadCredential=wrapping.key:/etc/cyberpanel/secrets/wrapping.key
StateDirectory=cyberpanel-secrets
StateDirectoryMode=0700
RuntimeDirectory=cyberpanel-secrets
RuntimeDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/cyberpanel
ReadWritePaths=/var/lib/cyberpanel-secrets /run/cyberpanel-secrets
InaccessiblePaths=-/var/lib/cyberpanel/control -/var/lib/cyberpanel-auth -/run/docker.sock -/var/run/docker.sock
LimitNOFILE=1024
TasksMax=128

[Install]
WantedBy=multi-user.target
