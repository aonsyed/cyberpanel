[Unit]
Description=CyberPanel socket peer identity inspector
Before=panel-secretd.service

[Service]
Type=simple
User=root
Group=cyberpanel-secrets
ExecStart=/usr/local/libexec/cyberpanel/panel-peer-inspectd
RuntimeDirectory=cyberpanel-identity
RuntimeDirectoryMode=0710
UMask=0077
Restart=on-failure
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/run/cyberpanel-identity
InaccessiblePaths=-/var/lib/cyberpanel-secrets -/var/lib/cyberpanel-auth -/var/lib/cyberpanel/control -/etc/cyberpanel/secrets
LimitNOFILE=128
TasksMax=32

[Install]
WantedBy=multi-user.target
