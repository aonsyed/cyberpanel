[Unit]
Description=CyberPanel disposable source migration extractor
Documentation=https://github.com/aonsyed/cyberpanel
After=local-fs.target network-online.target mariadb.service mysql.service cyberpanel-cutover.service
Wants=network-online.target cyberpanel-cutover.service
ConditionPathExists=/etc/cyberpanel/migration/cyberpanel-extract.enabled
ConditionFileNotEmpty=/etc/cyberpanel/migration/cyberpanel-extract.json
ConditionFileNotEmpty=/etc/cyberpanel/migration/mariadb-readonly.cnf
ConditionFileNotEmpty=/etc/cyberpanel/migration/source-agent.crt
ConditionFileNotEmpty=/etc/cyberpanel/migration/target-client-ca.pem
ConditionFileNotEmpty=/etc/cyberpanel/migration/credentials/source-agent.key
ConditionFileNotEmpty=/etc/cyberpanel/migration/credentials/manifest-signing.key

[Service]
Type=simple
User=cyberpanel
Group=cyberpanel
LoadCredential=source-agent.key:/etc/cyberpanel/migration/credentials/source-agent.key
LoadCredential=manifest-signing.key:/etc/cyberpanel/migration/credentials/manifest-signing.key
ExecStart=/usr/local/libexec/cyberpanel/cyberpanel-extract
WorkingDirectory=/var/lib/cyberpanel-migration
UMask=0077
RuntimeDirectory=cyberpanel-extract
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
Restart=on-failure
RestartSec=3s
TimeoutStartSec=45s
TimeoutStopSec=45s
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
ReadOnlyPaths=/etc/cyberpanel/migration /etc/letsencrypt /etc/opendkim /var/lib/cyberpanel-migration/source-plans /var/spool/cron
ReadWritePaths=/run/cyberpanel-extract /var/lib/cyberpanel-migration/source-grants /var/lib/cyberpanel-migration/source-sessions /var/lib/cyberpanel-migration/artifacts /var/lib/cyberpanel-migration/chunks
NoExecPaths=/var/lib/cyberpanel-migration/source-grants /var/lib/cyberpanel-migration/source-sessions /var/lib/cyberpanel-migration/artifacts /var/lib/cyberpanel-migration/chunks
InaccessiblePaths=/root /etc/shadow /etc/gshadow /etc/cyberpanel/secrets /var/lib/cyberpanel/control /var/lib/cyberpanel-auth /var/lib/cyberpanel-secrets
LimitNOFILE=1024
LimitNPROC=64
LimitCORE=0
LimitFSIZE=2199023255552
TasksMax=64
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=0
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
