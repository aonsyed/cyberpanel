[Unit]
Description=CyberPanel source migration cutover fence helper
Documentation=https://github.com/aonsyed/cyberpanel
After=local-fs.target systemd-user-sessions.service mariadb.service mysql.service
Before=panel-core.service
ConditionFileNotEmpty=/etc/cyberpanel/migration/cutover.json

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/cyberpanel/cyberpanel-cutover -config /etc/cyberpanel/migration/cutover.json
UMask=0077
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=45s
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=
ReadOnlyPaths=/etc/cyberpanel/migration
ReadWritePaths=/run/cyberpanel-migration /run/systemd /run/mysqld /var/lib/cyberpanel-migration/cutover
LimitNOFILE=128
LimitNPROC=32
LimitCORE=0
TasksMax=32

[Install]
WantedBy=multi-user.target
