[Unit]
Description=CyberPanel disposable cPanel archive migrator %i
Documentation=https://github.com/aonsyed/cyberpanel
After=local-fs.target
PartOf=panel-core.service
ConditionPathExists=/etc/cyberpanel/migration/cpanel-archive/%i.json

[Service]
Type=oneshot
User=cyberpanel
Group=cyberpanel
# The operator-provided config points its two private-key paths at the matching
# files below %d; the package never creates key material.
LoadCredential=manifest-signing.key:/etc/cyberpanel/migration/cpanel-archive/%i/manifest-signing.key
LoadCredential=archive-gate-authentication.key:/etc/cyberpanel/migration/cpanel-archive/%i/archive-gate-authentication.key
ExecStart=/usr/local/libexec/cyberpanel/cpanel-archive-migrator -config /etc/cyberpanel/migration/cpanel-archive/%i.json
WorkingDirectory=/var/lib/cyberpanel/migration/cpanel-intake
UMask=0077
StandardInput=null
TimeoutStartSec=24h
TimeoutStopSec=30s
RuntimeMaxSec=24h
CPUQuota=200%
CPUWeight=10
IOWeight=10
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=0
TasksMax=64
LimitNOFILE=1024
LimitNPROC=64
LimitCORE=0
LimitFSIZE=2199023255552
OOMPolicy=stop
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/cyberpanel/migration/cpanel-archive
ReadWritePaths=/var/lib/cyberpanel/migration/cpanel-intake
NoExecPaths=/var/lib/cyberpanel/migration/cpanel-intake /var/backups
InaccessiblePaths=/etc/cyberpanel/secrets /var/lib/cyberpanel/control /var/lib/cyberpanel/migration/cpanel-quarantine /var/lib/cyberpanel-auth /var/lib/cyberpanel-secrets /var/lib/cyberpanel/sites /var/lib/cyberpanel/quarantine /var/lib/cyberpanel/tombstones /run/docker.sock /var/run/docker.sock
